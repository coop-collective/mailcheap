# Legacy alternative to .env; use .env.example for new installations.
# Project scripts prefer .env when both files exist. Never commit real secrets.
ADMIN_EMAIL=admin@example.com
# Choose a password of at least 12 characters.
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
APP_URL=
LOCAL_APP_URL=http://localhost:3000
SENDING_ENABLED=false
LOCAL_SENDING_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials.
AWS_SESSION_TOKEN=
SES_CONFIGURATION_SET=mailcheap
SES_SNS_TOPIC_ARN=
SEND_RATE_PER_SECOND=1
ARCHIVE_HOSTS=
ALERT_FROM=
