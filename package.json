{
  "name": "mailcheap",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "preview": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "node -- scripts/deploy.mjs",
    "preview:deploy": "node -- scripts/preview.mjs",
    "setup:ci": "node -- scripts/setup-ci.mjs",
    "lint": "eslint",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "check:cloudflare": "node scripts/check-cloudflare.mjs",
    "db:migrate:local": "node -- scripts/wrangler.mjs d1 migrations apply DB --local",
    "db:migrate:remote": "node -- scripts/wrangler.mjs d1 migrations apply DB --remote",
    "db:exec": "node -- scripts/wrangler.mjs d1 execute DB",
    "cf:types": "node -- scripts/wrangler.mjs types",
    "cf": "node -- scripts/wrangler.mjs",
    "check": "pnpm test && pnpm run test:upstream && pnpm run lint && pnpm run check:cloudflare && pnpm run build",
    "test:upstream": "node --test scripts/upstream-sync.test.mjs",
    "setup": "node -- scripts/setup.mjs",
    "setup:cloudflare": "node -- scripts/setup.mjs --cloudflare"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-file-handler": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@vinext/cloudflare": "^1.1.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@tailwindcss/postcss": "^4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.36",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsonc-parser": "^3.3.1",
    "miniflare": "5.20261006.1-alpha",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
