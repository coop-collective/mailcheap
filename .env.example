# pnpm setup walks through setup and fills missing values in private .env.
# pnpm deploy reads these overrides; shared wrangler.jsonc stays generic.
# Never commit this file after entering real values. Copy it to .env first.
CLOUDFLARE_ACCOUNT_ID=
# Optional: use a scoped API token instead of Wrangler browser login.
CLOUDFLARE_API_TOKEN=
WORKER_NAME=mailcheap
D1_DATABASE_ID=
# Leave the name blank to discover an existing database by its ID.
D1_DATABASE_NAME=
R2_ENABLED=true
R2_BUCKET_NAME=
EMAIL_QUEUE_NAME=
EMAIL_DEAD_LETTER_QUEUE_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=
# Production URL. Setup discovers your workers.dev address if blank.
APP_URL=
LOCAL_APP_URL=http://localhost:3000
SENDING_ENABLED=false
LOCAL_SENDING_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials.
AWS_SESSION_TOKEN=
SES_CONFIGURATION_SET=mailcheap
SES_SNS_TOPIC_ARN=
SEND_RATE_PER_SECOND=1
ARCHIVE_HOSTS=
ALERT_FROM=
